# --------------------------------------------------------------------- #
# -- Application Parameters
# --------------------------------------------------------------------- #
PORT=3010
# 24 Hours
JWT_EXPIRES_IN=86400
# To deploy with Serverless un-comment the following line. To deploy locally comment it.
DEPLOY_WITH_SERVERLESS=true
# SLS_DEBUG=*

# --------------------------------------------------------------------- #
# -- Video Streams Params
# --------------------------------------------------------------------- #
# Metadata/content API base URL
CONTENT_API_BASE_URL="https://api.example.com/v2"

# Non-production
EDGE_AUTH_HOSTNAME="vod-test.example.com"
EDGE_AUTH_LIVE_HOSTNAME="live-test.example.com"
TOKEN_EXPIRATION_WINDOW_IN_SECONDS=300
# Encryption Keys
ENCRYPTION_KEY=
LIVE_ENCRYPTION_KEY=

VIDEO_STREAMS_FORMATS=["json", "m3u8", "mpd", "live"]

# --------------------------------------------------------------------- #
# -- Local DB Instance - Development
# --------------------------------------------------------------------- #
# mysql stream-access-gateway
HOSTNAME=localhost
DB_TYPE=mysql
DB_PORT=3306
USERNAME=stream_access_gateway
PASSWORD=
DB_NAME=stream_access_gateway
DISPLAY_SQL=true
MIGRATIONS_TABLE_NAME=migrations
TYPEORM_SYNCHRONIZE=false
