# --------------------------------------------------------------------- #
# -- Application Parameters
# --------------------------------------------------------------------- #
PORT=3010
# 24 Hours
JWT_EXPIRES_IN=86400
# To deploy with Serverless un-comment the following line. To deploy locally comment it.
DEPLOY_WITH_SERVERLESS=true
# SLS_DEBUG=*

# --------------------------------------------------------------------- #
# -- Video Streams Params
# --------------------------------------------------------------------- #
# Beta
EDGE_AUTH_HOSTNAME="vod-test.sonyliv.wwe.com"
EDGE_AUTH_LIVE_HOSTNAME="live-test.sonyliv.wwe.com"
TOKEN_EXPIRATION_WINDOW_IN_SECONDS=300
# Encryption Keys
ENCRYPTION_KEY=
LIVE_ENCRYPTION_KEY=

# Production
# EDGE_AUTH_HOSTNAME="vod.sonyliv.wwe.com"
# ENCRYPTION_KEY=""
# EDGE_AUTH_LIVE_HOSTNAME="live.sonyliv.wwe.com"
# LIVE_ENCRYPTION_KEY=""

VIDEO_STREAMS_FORMATS=["json", "m3u8", "mpd", "live"]

# --------------------------------------------------------------------- #
# -- Local DB Instance - Development
# --------------------------------------------------------------------- #
# mysql stream-access-gateway
HOSTNAME=localhost
DB_TYPE=mysql
DB_PORT=3306
USERNAME=stream-access-gateway
PASSWORD=wwe1241wwe
DB_NAME=stream-access-gateway
DISPLAY_SQL=true
MIGRATIONS_TABLE_NAME=migrations
TYPEORM_SYNCHRONIZE=false

# Freighter DB
FHOSTNAME=localhost
FDB_TYPE=mysql
FDB_PORT=3306
FUSERNAME=
FPASSWORD=
FDB_NAME=
FARN_SECRET=
FARN_ACCESS=
FS3_BUCKET=
FS3_BUCKET_REGION="us-east-1"
FIMG_SIGNED_URL_EXPIRES=1200


