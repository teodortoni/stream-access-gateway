# App Variables
PORT=3010

# Mysql
DB_TYPE=mysql
HOSTNAME=localhost
DB_PORT=3306
USERNAME=
PASSWORD=
DB_NAME=stream-access-gateway
DISPLAY_SQL=true
MIGRATIONS_TABLE_NAME=migrations

# In production this should be set to false
TYPEORM_SYNCHRONIZE=false

# To deploy with Serverless un-comment the following line. To deploy locally comment it.
DEPLOY_WITH_SERVERLESS=true

# -------------------------------------------------------------
#                      AWS CONFIGURATION                      #
# -------------------------------------------------------------
#
# - AWS_OWN_STAGE - is used to define the stage of our application in AWS.
# Possible values are: prod, dev, demo, test
# Serverless yml file makes use of these variables
AWS_OWN_STAGE=demo
AWS_OWN_REGION=
AWS_OWN_VPC_SECURITY_GROUP=
AWS_OWN_VPC_SUBNET_1=
AWS_OWN_VPC_SUBNET_2=