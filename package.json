{
  "name": "stream-access-gateway",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "dev": "NODE_ENV=development npm run generate:ormconfig && nest start --watch",
    "debug": "nest start --debug --watch",
    "prod": "NODE_ENV=production node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "testwatch": "jest --watch",
    "testcoverage": "jest --coverage",
    "testdebug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "teste2e": "jest --config ./test/jest-e2e.json",
    "generate:ormconfig": "rm -f ormconfig.json && ts-node scripts/generateTypeORMConfigs.ts",
    "migration:create": "ts-node node_modules/.bin/typeorm migration:create -n",
    "migration:generate": "ts-node node_modules/.bin/typeorm migration:generate -n",
    "migrations": "node_modules/.bin/ts-node node_modules/.bin/typeorm migration:run",
    "revert:migrations": "ts-node node_modules/.bin/typeorm migration:revert",
    "typeorm:cache:clear": "ts-node node_modules/.bin/typeorm cache:clear",
    "deploy": "./scripts/deploy.sh"
  },
  "dependencies": {
    "@nestjs/common": "^7.4.4",
    "@nestjs/config": "^0.4.2",
    "@nestjs/core": "^7.4.4",
    "@nestjs/jwt": "^7.1.0",
    "@nestjs/passport": "^7.1.0",
    "@nestjs/platform-express": "^7.4.4",
    "@nestjs/typeorm": "^7.1.4",
    "akamai-edgeauth": "^0.2.0",
    "aws-serverless-express": "^3.3.8",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.2.3",
    "class-validator": "^0.12.2",
    "mysql": "^2.18.1",
    "passport": "^0.4.1",
    "passport-jwt": "^4.0.0",
    "pg": "^8.3.3",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^6.6.3",
    "ts-node": "^8.10.2",
    "typeorm": "^0.2.26",
    "uuid": "^7.0.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^7.5.1",
    "@nestjs/schematics": "^7.1.2",
    "@nestjs/testing": "^7.4.4",
    "@types/aws-lambda": "^8.10.62",
    "@types/aws-serverless-express": "^3.3.3",
    "@types/jest": "25.1.4",
    "@types/express": "^4.17.8",
    "@types/node": "^13.13.21",
    "@types/passport-oauth2": "^1.4.9",
    "@types/supertest": "^2.0.10",
    "@typescript-eslint/eslint-plugin": "^2.34.0",
    "@typescript-eslint/parser": "^2.34.0",
    "aws-lambda": "^1.0.6",
    "aws-sdk": "^2.763.0",
    "eslint": "^6.8.0",
    "eslint-config-prettier": "^6.10.0",
    "eslint-plugin-import": "^2.22.0",
    "husky": "4.1.0",
    "jest": "^25.5.4",
    "prettier": "^1.19.1",
    "pretty-quick": "^2.0.2",
    "serverless-dotenv-plugin": "^2.4.2",
    "serverless-jetpack": "^0.10.9",
    "serverless-plugin-datadog": "^2.13.0",
    "serverless-plugin-warmup": "^4.9.0",
    "supertest": "^4.0.2",
    "ts-jest": "25.2.1",
    "ts-loader": "^6.2.1",
    "tsconfig-paths": "^3.9.0",
    "typescript": "^3.9.7"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src/"
    ]
  },
  "prettier": {
    "tabWidth": 2,
    "semi": false,
    "quoteProps": "consistent",
    "arrowParens": "always",
    "printWidth": 100
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  }
}
